<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="closeButtonPressed"
        android:text="X" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="fill_parent"
        android:orientation="horizontal">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:orientation="vertical">

                <Switch
                    android:id="@+id/force2DSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Force 2D (this video)" />

                <Switch
                    android:id="@+id/softwareDecodingSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Software decoding (this video)" />

                <TextView
                    android:id="@+id/textViewEyeDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EyeDistance" />

                <SeekBar
                    android:id="@+id/seekBarEyeDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Video Mode" />

                <TextView
                    android:id="@+id/textViewDetectedMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:text="" />

                <RadioGroup
                    android:id="@+id/radio_group_video_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"></RadioGroup>

                <RadioGroup
                    android:id="@+id/radio_group_video_type_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"></RadioGroup>

                <RadioGroup
                    android:id="@+id/radio_group_video_type_aspect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"></RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Playback" />

                <TextView
                    android:id="@+id/textViewPlaybackSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speed" />

                <SeekBar
                    android:id="@+id/seekBarPlaybackSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/textViewAudioDelay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Audio delay" />

                <SeekBar
                    android:id="@+id/seekBarAudioDelay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/textViewSubtitleDelay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subtitle delay" />

                <SeekBar
                    android:id="@+id/seekBarSubtitleDelay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Audio" />

                <RadioGroup
                    android:id="@+id/radio_group_audio_tracks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Subtitle" />

                <RadioGroup
                    android:id="@+id/radio_group_subtitle_tracks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="    " />

            </LinearLayout>
        </ScrollView>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/options_fragment_container_view"
            android:name="autoandshare.headvr.activity.SettingFragment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
